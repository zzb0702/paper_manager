# 复制为 .env 并填写。所有服务均可缺省：缺什么就自动降级什么（见 README）。

# ---- LLM（入库时生成论文摘要卡；缺省则跳过摘要）----
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=glm-4-flash

# ---- Embedding（向量化检索；缺省自动降级为纯 FTS5）----
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_API_KEY=sk-xxx

# ---- Reranker（重排序；可选）----
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- Datalab（默认引擎，按页计费；多 key 轮询，逗号分隔）----
# 额度耗尽的 key 自动跳过换下一个，6 小时后自动重试
DATALAB_API_KEYS=key1,key2,key3
# 单 key 也可以（旧写法，仍兼容）：
# DATALAB_API_KEY=key1

# ---- 数据目录（默认 ./data）----
# PAPER_MANAGER_DATA_DIR=/absolute/path/to/paper_manager/data
