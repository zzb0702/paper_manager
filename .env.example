# 复制为 .env 并填写。与 other-local-project 的 .env 变量名一致，
# 可以直接把那边的文件复制过来。

# ---- LLM（入库时生成论文摘要卡；缺省则跳过摘要）----
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=glm-4-flash

# ---- Embedding（向量化检索；缺省自动降级为纯 FTS5）----
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_API_KEY=sk-xxx

# ---- Reranker（重排序；可选）----
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- Datalab（付费高保真 PDF 转换引擎；可选）----
DATALAB_API_KEY=

# ---- 数据目录（默认 ./data）----
# PAPER_MANAGER_DATA_DIR=/path/to/paper_manager\data
